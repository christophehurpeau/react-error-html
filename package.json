{
  "name": "react-error-html",
  "version": "0.2.2",
  "description": "react component to display errors with error-html",
  "keywords": [],
  "homepage": "https://github.com/christophehurpeau/react-error-html",
  "bugs": {
    "url": "https://github.com/christophehurpeau/react-error-html/issues"
  },
  "license": "ISC",
  "author": "Christophe Hurpeau <christophe@hurpeau.com> (https://christophe.hurpeau.com)",
  "repository": "https://github.com/christophehurpeau/react-error-html.git",
  "files": [
    "src",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index-node22.mjs",
  "module": "./dist/index-browser.es.js",
  "browser": "./dist/index-browser.es.js",
  "types": "./dist/definitions/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/definitions/index.d.ts",
      "node": {
        "import": "./dist/index-node22.mjs"
      },
      "browser": {
        "import": "./dist/index-browser.es.js"
      }
    }
  },
  "scripts": {
    "build": "pnpm run clean:build && rollup --config rollup.config.mjs && pnpm run build:definitions",
    "build:definitions": "tsrs -p tsconfig.json",
    "clean:build": "pob-esbuild-clean-out dist",
    "format": "oxfmt",
    "format:check": "oxfmt --check .",
    "lint": "pnpm run format && pnpm run lint:oxlint && tsrs && pnpm run lint:eslint",
    "lint:eslint": "eslint --quiet .",
    "lint:oxlint": "oxlint --quiet",
    "prepare": "pob-root-postinstall",
    "test": "TZ=UTC node --test 'src/**/*.test.ts'",
    "test:coverage": "TZ=UTC node --test --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" 'src/**/*.test.ts'",
    "test:coverage:generate": "mkdir -p generated-docs && TZ=UTC node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=generated-docs/coverage.lcov --test-coverage-include=\"src/**/*.ts\" 'src/**/*.test.ts'",
    "test:watch": "TZ=UTC node --test 'src/**/*.test.ts'",
    "tsc": "tsrs && tsrs -p tsconfig.tools.json",
    "tsc:go": "tsc && tsc -p tsconfig.tools.json"
  },
  "dependencies": {
    "error-html": "^0.3.0"
  },
  "devDependencies": {
    "@pob/eslint-config": "68.3.0",
    "@pob/eslint-config-typescript-react": "68.4.0",
    "@pob/rollup-esbuild": "11.3.0",
    "@pob/root": "28.6.1",
    "@types/react": "16.14.70",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.14.0",
    "react": "16.14.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "peerDependencies": {
    "react": "^15.6.1 || ^16.0.0"
  },
  "commitlint": {
    "extends": [
      "@pob/root/commitlint-config"
    ]
  },
  "browserslist": {
    "production": [
      "defaults",
      "> 0.2%",
      "not ie < 12",
      "not safari < 10",
      "not ios_saf < 10"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.0.0",
      "onFail": "ignore"
    }
  },
  "engines": {
    "node": "^22.18.0 || >=24.14.1"
  },
  "pob": {
    "bundler": "rollup-esbuild",
    "entries": [
      "index"
    ],
    "envs": [
      {
        "target": "node",
        "version": "22"
      },
      {
        "target": "browser"
      }
    ],
    "typescript": true
  }
}
